{
  "name": "xbitto-mcp",
  "version": "0.1.1",
  "description": "MCP server for Xbitto: let an AI agent create links, fill access code pools and upload galleries, videos and episodes.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "xbitto-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackcheet/xbitto-mcp.git"
  },
  "homepage": "https://xbitto.com",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node scripts/build.mjs --verify"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "image-size": "2.0.4",
    "tus-js-client": "4.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
